# .env.example - Copie para .env e ajuste os valores

# API Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# CORS - Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=*

# Model Configuration
MODEL_DIR=./agrovision/models/weights
YOLO_MODEL=yolov5s.pt
TRACKER_MODEL=deepsort

# Video Processing
MAX_VIDEO_SIZE_MB=500
FRAME_SKIP=1
CONFIDENCE_THRESHOLD=0.5

# Database
DATABASE_URL=sqlite:///./agrovision.db
DB_ECHO=False

# Edge Computing
EDGE_MODE=False
QUANTIZE_MODELS=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/agrovision.log

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# AWS S3 (Optional)
# AWS_ACCESS_KEY=your_access_key
# AWS_SECRET_KEY=your_secret_key
# S3_BUCKET=your_bucket_name